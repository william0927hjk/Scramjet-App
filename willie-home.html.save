<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Willie Games</title>
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg: #0a0a0c;
      --sidebar-bg: #101014;
      --card-bg: #14141a;
      --card-hover: #1c1c26;
      --silver: #b0bec5;
      --silver-bright: #e0e8ef;
      --silver-dim: #607d8b;
      --accent: #78909c;
      --border: #1e2a32;
      --border-bright: #37474f;
      --text: #cfd8dc;
      --text-dim: #546e7a;
      --glow: rgba(176,190,197,0.15);
      --custom-bg: none;
    }
    *{margin:0;padding:0;box-sizing:border-box;}
    body{background:var(--bg);color:var(--text);font-family:'Rajdhani',sans-serif;display:flex;height:100vh;overflow:hidden;position:relative;}
    body::before{content:'';position:fixed;inset:0;background:var(--custom-bg);background-size:cover;background-position:center;z-index:0;pointer-events:none;opacity:0.18;}

    /* LOCK SCREEN */
    #lock-screen{position:fixed;inset:0;background:#0a0a0c;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;}
    #lock-screen h1{font-family:'Orbitron',monospace;font-size:24px;color:var(--silver-bright);letter-spacing:4px;}
    #lock-screen p{color:var(--silver-dim);font-size:14px;letter-spacing:2px;}
    #lock-input{background:var(--card-bg);border:1px solid var(--border-bright);color:var(--text);padding:12px 20px;border-radius:8px;font-family:'Rajdhani',sans-serif;font-size:16px;width:260px;outline:none;text-align:center;letter-spacing:4px;}
    #lock-input:focus{border-color:var(--silver);}
    #lock-btn{background:linear-gradient(135deg,#1e2a32,#253035);border:1px solid var(--border-bright);color:var(--silver-bright);padding:10px 32px;border-radius:8px;font-family:'Orbitron',monospace;font-size:11px;letter-spacing:2px;cursor:pointer;transition:all 0.2s;}
    #lock-btn:hover{border-color:var(--silver);}
    #lock-error{color:#ef5350;font-size:12px;letter-spacing:2px;min-height:16px;}
    #lock-setup{font-size:12px;color:var(--text-dim);cursor:pointer;text-decoration:underline;margin-top:8px;}

    /* SIDEBAR */
    #sidebar{width:220px;min-width:220px;background:var(--sidebar-bg);border-right:1px solid var(--border);display:flex;flex-direction:column;position:relative;z-index:10;}
    #logo{padding:24px 20px 20px;border-bottom:1px solid var(--border);}
    #logo h1{font-family:'Orbitron',monospace;font-size:18px;font-weight:900;color:var(--silver-bright);letter-spacing:2px;text-transform:uppercase;line-height:1;}
    #logo span{font-family:'Rajdhani',sans-serif;font-size:11px;color:var(--silver-dim);letter-spacing:3px;text-transform:uppercase;}
    nav{flex:1;padding:12px 0;overflow-y:auto;}
    .nav-label{font-size:10px;letter-spacing:3px;color:var(--text-dim);text-transform:uppercase;padding:8px 20px 4px;font-family:'Orbitron',monospace;}
    .nav-item{display:flex;align-items:center;gap:12px;padding:10px 20px;cursor:pointer;color:var(--silver-dim);font-size:14px;font-weight:600;letter-spacing:1px;border-left:3px solid transparent;transition:all 0.2s;text-decoration:none;}
    .nav-item:hover{color:var(--silver-bright);background:var(--glow);border-left-color:var(--silver);}
    .nav-item.active{color:var(--silver-bright);background:linear-gradient(90deg,rgba(176,190,197,0.1),transparent);border-left-color:var(--silver-bright);}
    .nav-icon{font-size:16px;width:20px;text-align:center;}
    .nav-badge{margin-left:auto;background:var(--border-bright);color:var(--silver);font-size:10px;padding:2px 6px;border-radius:8px;font-family:'Orbitron',monospace;}
    #sidebar-bottom{padding:12px 0;border-top:1px solid var(--border);}

    /* MAIN */
    #main{flex:1;display:flex;flex-direction:column;overflow:hidden;position:relative;z-index:1;}
    #topbar{height:56px;background:var(--sidebar-bg);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 24px;gap:14px;flex-shrink:0;}
    #topbar h2{font-family:'Orbitron',monospace;font-size:12px;font-weight:700;color:var(--silver);letter-spacing:3px;text-transform:uppercase;white-space:nowrap;}
    #search{margin-left:auto;background:var(--card-bg);border:1px solid var(--border);color:var(--text);padding:7px 14px;border-radius:6px;font-family:'Rajdhani',sans-serif;font-size:14px;width:200px;outline:none;transition:border-color 0.2s;}
    #search:focus{border-color:var(--silver);}
    #search::placeholder{color:var(--text-dim);}
    #content{flex:1;overflow-y:auto;padding:24px;scrollbar-width:thin;scrollbar-color:var(--border-bright) transparent;}
    #content::-webkit-scrollbar{width:4px;}
    #content::-webkit-scrollbar-thumb{background:var(--border-bright);border-radius:2px;}

    /* VIEWS */
    .view{display:none;}
    .view.active{display:block;}

    /* HERO */
    .hero{background:linear-gradient(135deg,#101018,#141420);border:1px solid var(--border);border-radius:12px;padding:36px;margin-bottom:24px;position:relative;overflow:hidden;}
    .hero::before{content:'';position:absolute;top:-40%;right:-5%;width:350px;height:350px;background:radial-gradient(circle,rgba(176,190,197,0.07),transparent 70%);pointer-events:none;}
    .hero h2{font-family:'Orbitron',monospace;font-size:26px;font-weight:900;color:var(--silver-bright);letter-spacing:3px;margin-bottom:8px;}
    .hero p{color:var(--silver-dim);font-size:15px;max-width:460px;line-height:1.6;}
    .stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:24px;}
    .stat-card{background:var(--card-bg);border:1px solid var(--border);border-radius:10px;padding:18px;text-align:center;}
    .stat-num{font-family:'Orbitron',monospace;font-size:24px;font-weight:900;color:var(--silver-bright);}
    .stat-label{font-size:11px;color:var(--text-dim);letter-spacing:2px;text-transform:uppercase;margin-top:4px;}

    /* SECTION TITLE */
    .section-title{font-family:'Orbitron',monospace;font-size:10px;letter-spacing:4px;color:var(--silver-dim);text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:12px;}
    .section-title::after{content:'';flex:1;height:1px;background:var(--border);}

    /* GAMES GRID */
    .games-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;margin-bottom:32px;}
    .game-card{background:var(--card-bg);border:1px solid var(--border);border-radius:10px;overflow:hidden;cursor:pointer;transition:all 0.2s;text-decoration:none;display:block;position:relative;}
    .game-card:hover{background:var(--card-hover);border-color:var(--border-bright);transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,0.4);}
    .game-thumb{width:100%;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;font-size:36px;background:linear-gradient(135deg,#141420,#0e1520);border-bottom:1px solid var(--border);position:relative;overflow:hidden;}
    .game-thumb img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;}
    .game-info{padding:10px 12px;}
    .game-name{font-family:'Orbitron',monospace;font-size:10px;font-weight:700;color:var(--silver-bright);letter-spacing:1px;text-transform:uppercase;margin-bottom:3px;}
    .game-genre{font-size:11px;color:var(--text-dim);letter-spacing:1px;}
    .fav-btn{position:absolute;top:6px;right:6px;background:rgba(0,0,0,0.5);border:1px solid var(--border);border-radius:6px;width:26px;height:26px;display:flex;align-items:center;justify-content:center;font-size:14px;cursor:pointer;z-index:2;transition:all 0.2s;opacity:0;}
    .game-card:hover .fav-btn{opacity:1;}
    .fav-btn.active{opacity:1;color:#ffd600;}
    .fav-btn:hover{background:rgba(0,0,0,0.8);}

    /* PROXY */
    #view-proxy{display:none;flex-direction:column;height:100%;}
    #view-proxy.active{display:flex;}
    .bookmark-bar{display:flex;gap:6px;padding:8px 0;border-bottom:1px solid var(--border);margin-bottom:10px;flex-wrap:wrap;min-height:36px;}
    .bookmark-chip{background:var(--card-bg);border:1px solid var(--border);color:var(--text);padding:4px 10px;border-radius:6px;font-size:12px;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all 0.2s;white-space:nowrap;}
    .bookmark-chip:hover{border-color:var(--border-bright);color:var(--silver-bright);}
    .bookmark-chip .del-bm{color:var(--text-dim);font-size:10px;margin-left:2px;}
    .bookmark-chip .del-bm:hover{color:#ef5350;}
    .add-bm-btn{background:transparent;border:1px dashed var(--border);color:var(--text-dim);padding:4px 10px;border-radius:6px;font-size:12px;cursor:pointer;transition:all 0.2s;}
    .add-bm-btn:hover{border-color:var(--silver);color:var(--silver);}
    .proxy-bar{display:flex;gap:8px;margin-bottom:10px;align-items:center;}
    .nav-btn{background:var(--card-bg);border:1px solid var(--border);color:var(--silver);width:34px;height:34px;border-radius:8px;font-size:16px;cursor:pointer;transition:all 0.2s;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
    .nav-btn:hover{background:var(--card-hover);border-color:var(--border-bright);color:var(--silver-bright);}
    #proxy-url{flex:1;background:var(--card-bg);border:1px solid var(--border);color:var(--text);padding:8px 14px;border-radius:8px;font-family:'Rajdhani',sans-serif;font-size:14px;outline:none;transition:border-color 0.2s;}
    #proxy-url:focus{border-color:var(--silver);}
    #proxy-frame-container{flex:1;border-radius:10px;overflow:hidden;border:1px solid var(--border);min-height:0;}
    #proxy-frame-container iframe{width:100%;height:100%;border:none;display:block;}
    .btn{background:linear-gradient(135deg,#1e2a32,#253035);border:1px solid var(--border-bright);color:var(--silver-bright);padding:8px 18px;border-radius:8px;font-family:'Orbitron',monospace;font-size:10px;letter-spacing:2px;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
    .btn:hover{border-color:var(--silver);}

    /* SETTINGS */
    #settings-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:100;backdrop-filter:blur(4px);}
    #settings-overlay.open{display:block;}
    #settings-panel{position:fixed;right:0;top:0;bottom:0;width:380px;background:#0e0e14;border-left:1px solid var(--border-bright);z-index:101;transform:translateX(100%);transition:transform 0.3s cubic-bezier(0.4,0,0.2,1);display:flex;flex-direction:column;}
    #settings-overlay.open #settings-panel{transform:translateX(0);}
    #settings-header{padding:22px 22px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
    #settings-header h3{font-family:'Orbitron',monospace;font-size:12px;font-weight:700;color:var(--silver-bright);letter-spacing:3px;text-transform:uppercase;}
    #settings-close{cursor:pointer;color:var(--text-dim);font-size:20px;transition:color 0.2s;}
    #settings-close:hover{color:var(--silver-bright);}
    #settings-body{flex:1;overflow-y:auto;padding:22px;}
    .sg{margin-bottom:26px;}
    .sg-title{font-family:'Orbitron',monospace;font-size:10px;letter-spacing:3px;color:var(--text-dim);text-transform:uppercase;margin-bottom:12px;}
    .sr{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--border);}
    .sl{font-size:14px;color:var(--text);font-weight:600;}
    .ss{font-size:11px;color:var(--text-dim);margin-top:2px;}
    .toggle{position:relative;width:42px;height:22px;}
    .toggle input{opacity:0;width:0;height:0;}
    .ts{position:absolute;cursor:pointer;inset:0;background:var(--border-bright);border-radius:22px;transition:0.3s;}
    .ts:before{content:'';position:absolute;height:16px;width:16px;left:3px;bottom:3px;background:var(--silver-dim);border-radius:50%;transition:0.3s;}
    input:checked+.ts{background:var(--silver);}
    input:checked+.ts:before{transform:translateX(20px);background:#0a0a0c;}
    .ss-select{background:var(--card-bg);border:1px solid var(--border-bright);color:var(--text);padding:5px 10px;border-radius:6px;font-family:'Rajdhani',sans-serif;font-size:13px;outline:none;cursor:pointer;}
    .color-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:8px;}
    .color-swatch{width:100%;aspect-ratio:1;border-radius:8px;cursor:pointer;border:2px solid transparent;transition:all 0.2s;}
    .color-swatch:hover,.color-swatch.active{border-color:var(--silver-bright);}
    .bg-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:8px;}
    .bg-option{aspect-ratio:16/9;border-radius:8px;cursor:pointer;border:2px solid transparent;transition:all 0.2s;background-size:cover;background-position:center;display:flex;align-items:center;justify-content:center;font-size:11px;color:rgba(255,255,255,0.7);font-family:'Orbitron',monospace;letter-spacing:1px;}
    .bg-option:hover,.bg-option.active{border-color:var(--silver-bright);}
    .pwd-input{background:var(--card-bg);border:1px solid var(--border-bright);color:var(--text);padding:7px 12px;border-radius:6px;font-family:'Rajdhani',sans-serif;font-size:14px;outline:none;width:100%;margin-top:6px;}
    .pwd-input:focus{border-color:var(--silver);}
    .save-btn{margin-top:8px;background:var(--card-bg);border:1px solid var(--border-bright);color:var(--silver-bright);padding:7px 16px;border-radius:6px;font-family:'Orbitron',monospace;font-size:10px;letter-spacing:2px;cursor:pointer;transition:all 0.2s;width:100%;}
    .save-btn:hover{border-color:var(--silver);}
  </style>
</head>
<body>

<!-- LOCK SCREEN -->
<div id="lock-screen" style="display:none;">
  <h1>WILLIE GAMES</h1>
  <p>ENTER PASSWORD</p>
  <input type="password" id="lock-input" placeholder="••••••••" maxlength="32"/>
  <div id="lock-error"></div>
  <button id="lock-btn" onclick="tryUnlock()">Unlock</button>
  <span id="lock-setup" onclick="setupPassword()">Set up password</span>
</div>

<!-- SIDEBAR -->
<div id="sidebar">
  <div id="logo">
    <h1>Willie</h1>
    <span>Games Hub</span>
  </div>
  <nav>
    <div class="nav-label">Menu</div>
    <div class="nav-item active" onclick="showView('home',this)"><span class="nav-icon">⬡</span>Home</div>
    <div class="nav-item" onclick="showView('games',this)"><span class="nav-icon">◈</span>Games<span class="nav-badge" id="game-count">0</span></div>
    <div class="nav-item" onclick="showView('favorites',this)"><span class="nav-icon">★</span>Favorites<span class="nav-badge" id="fav-count">0</span></div>
    <div class="nav-item" onclick="showView('recent',this)"><span class="nav-icon">◷</span>Recent</div>
    <div class="nav-item" onclick="showView('proxy',this)"><span class="nav-icon">◎</span>Proxy</div>
    <div class="nav-label" style="margin-top:8px">System</div>
    <div class="nav-item" onclick="openSettings()"><span class="nav-icon">◧</span>Settings</div>
  </nav>
  <div id="sidebar-bottom">
    <div class="nav-item" style="font-size:11px;color:var(--text-dim)"><span class="nav-icon">◌</span>Willie Games v2.0</div>
  </div>
</div>

<!-- MAIN -->
<div id="main">
  <div id="topbar">
    <h2 id="page-title">Home</h2>
    <input type="text" id="search" placeholder="Search games..." oninput="filterGames(this.value)"/>
  </div>
  <div id="content">

    <!-- HOME -->
    <div class="view active" id="view-home">
      <div class="hero">
        <h2>WILLIE GAMES</h2>
        <p>Your personal unblocked games hub. Play anywhere, anytime.</p>
      </div>
      <div class="stats-row">
        <div class="stat-card"><div class="stat-num" id="stat-total">0</div><div class="stat-label">Games</div></div>
        <div class="stat-card"><div class="stat-num" id="stat-favs">0</div><div class="stat-label">Favorites</div></div>
        <div class="stat-card"><div class="stat-num" id="stat-played">0</div><div class="stat-label">Played</div></div>
      </div>
      <div class="section-title">Recently Played</div>
      <div class="games-grid" id="recent-grid"><div style="color:var(--text-dim);font-size:13px;grid-column:1/-1">No games played yet.</div></div>
      <div class="section-title">Featured</div>
      <div class="games-grid" id="featured-grid"></div>
    </div>

    <!-- ALL GAMES -->
    <div class="view" id="view-games">
      <div class="section-title">All Games</div>
      <div class="games-grid" id="all-games-grid"></div>
    </div>

    <!-- FAVORITES -->
    <div class="view" id="view-favorites">
      <div class="section-title">Favorites</div>
      <div class="games-grid" id="fav-grid"><div style="color:var(--text-dim);font-size:13px;grid-column:1/-1">No favorites yet — click ★ on a game card!</div></div>
    </div>

    <!-- RECENT -->
    <div class="view" id="view-recent">
      <div class="section-title">Recently Played</div>
      <div class="games-grid" id="recent-grid2"><div style="color:var(--text-dim);font-size:13px;grid-column:1/-1">No games played yet.</div></div>
    </div>

    <!-- PROXY -->
    <div class="view" id="view-proxy">
      <div class="bookmark-bar" id="bookmark-bar">
        <button class="add-bm-btn" onclick="addBookmark()">+ Bookmark</button>
      </div>
      <div class="proxy-bar">
        <button class="nav-btn" onclick="proxyBack()" title="Back">&#8592;</button>
        <button class="nav-btn" onclick="proxyForward()" title="Forward">&#8594;</button>
        <button class="nav-btn" onclick="proxyRefresh()" title="Refresh">&#8635;</button>
        <input type="text" id="proxy-url" placeholder="Enter a URL like google.com"/>
        <button class="btn" onclick="loadProxy()">Go →</button>
      </div>
      <div id="proxy-frame-container">
        <iframe id="proxy-iframe" src="about:blank"></iframe>
      </div>
    </div>

  </div>
</div>

<!-- SETTINGS -->
<div id="settings-overlay" onclick="closeSettingsOutside(event)">
  <div id="settings-panel">
    <div id="settings-header">
      <h3>Settings</h3>
      <span id="settings-close" onclick="closeSettings()">✕</span>
    </div>
    <div id="settings-body">

      <div class="sg">
        <div class="sg-title">Theme Color</div>
        <div class="color-grid">
          <div class="color-swatch active" style="background:#b0bec5" onclick="setTheme('silver',this)" title="Silver"></div>
          <div class="color-swatch" style="background:#64b5f6" onclick="setTheme('blue',this)" title="Blue"></div>
          <div class="color-swatch" style="background:#69f0ae" onclick="setTheme('green',this)" title="Green"></div>
          <div class="color-swatch" style="background:#ce93d8" onclick="setTheme('purple',this)" title="Purple"></div>
          <div class="color-swatch" style="background:#ff8a65" onclick="setTheme('orange',this)" title="Orange"></div>
          <div class="color-swatch" style="background:#f48fb1" onclick="setTheme('pink',this)" title="Pink"></div>
          <div class="color-swatch" style="background:#fff176" onclick="setTheme('yellow',this)" title="Yellow"></div>
          <div class="color-swatch" style="background:#80cbc4" onclick="setTheme('teal',this)" title="Teal"></div>
        </div>
      </div>

      <div class="sg">
        <div class="sg-title">Background</div>
        <div class="bg-grid">
          <div class="bg-option active" style="background:#0a0a0c" onclick="setBg('none',this)">None</div>
          <div class="bg-option" style="background:linear-gradient(135deg,#0d1b2a,#1b263b)" onclick="setBg('ocean',this)">Ocean</div>
          <div class="bg-option" style="background:linear-gradient(135deg,#1a0a2e,#2d1b69)" onclick="setBg('galaxy',this)">Galaxy</div>
          <div class="bg-option" style="background:linear-gradient(135deg,#0a1a0a,#1a3a1a)" onclick="setBg('forest',this)">Forest</div>
          <div class="bg-option" style="background:linear-gradient(135deg,#1a0a0a,#3a1010)" onclick="setBg('crimson',this)">Crimson</div>
          <div class="bg-option" style="background:linear-gradient(135deg,#0a0a1a,#10102a,#1a0a2e);background-size:400% 400%" onclick="setBg('midnight',this)">Midnight</div>
        </div>
      </div>

      <div class="sg">
        <div class="sg-title">Appearance</div>
        <div class="sr">
          <div><div class="sl">Compact Mode</div><div class="ss">Smaller game cards</div></div>
          <label class="toggle"><input type="checkbox" id="compact-toggle" onchange="toggleCompact(this)"/><span class="ts"></span></label>
        </div>
        <div class="sr">
          <div><div class="sl">Show Thumbnails</div><div class="ss">Load game preview images</div></div>
          <label class="toggle"><input type="checkbox" id="thumb-toggle" checked onchange="saveSettings();renderAll()"/><span class="ts"></span></label>
        </div>
      </div>

      <div class="sg">
        <div class="sg-title">Games</div>
        <div class="sr">
          <div><div class="sl">Open in New Tab</div><div class="ss">Games open in a new tab</div></div>
          <label class="toggle"><input type="checkbox" id="newtab-toggle" onchange="saveSettings()"/><span class="ts"></span></label>
        </div>
      </div>

      <div class="sg">
        <div class="sg-title">Privacy</div>
        <div class="sr">
          <div><div class="sl">Panic Key</div><div class="ss">Escape to blank page</div></div>
          <label class="toggle"><input type="checkbox" id="panic-toggle" checked onchange="saveSettings()"/><span class="ts"></span></label>
        </div>
        <div class="sr">
          <div><div class="sl">Cloak Tab</div><div class="ss">Disguise tab title</div></div>
          <select class="ss-select" onchange="cloakTab(this.value)">
            <option value="none">None</option>
            <option value="google">Google</option>
            <option value="classroom">Google Classroom</option>
            <option value="docs">Google Docs</option>
          </select>
        </div>
      </div>

      <div class="sg">
        <div class="sg-title">Password Lock</div>
        <div class="sr">
          <div><div class="sl">Enable Lock</div><div class="ss">Require password on open</div></div>
          <label class="toggle"><input type="checkbox" id="lock-toggle" onchange="toggleLock(this)"/><span class="ts"></span></label>
        </div>
        <input type="password" class="pwd-input" id="pwd-new" placeholder="New password"/>
        <input type="password" class="pwd-input" id="pwd-confirm" placeholder="Confirm password" style="margin-top:6px"/>
        <button class="save-btn" onclick="savePassword()">Save Password</button>
        <div id="pwd-msg" style="font-size:12px;margin-top:6px;color:var(--silver-dim);"></div>
      </div>

    </div>
  </div>
</div>

<script>
// ── DATA ──
const games = [
  {name:"1v1 LOL",genre:"Shooter",emoji:"🎯",path:"gfiles/games/1v1lol/index.html"},
