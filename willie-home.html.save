  {name:"Duck Life 2",genre:"RPG",emoji:"🦆",path:"gfiles/games/ducklife2/index.html"},
  {name:"Duck Life 3",genre:"RPG",emoji:"🦆",path:"gfiles/games/ducklife3/index.html"},
  {name:"Duck Life 4",genre:"RPG",emoji:"🦆",path:"gfiles/games/ducklife4/index.html"},
  {name:"Duck Life 5",genre:"RPG",emoji:"🦆",path:"gfiles/games/ducklife5/index.html"},
  {name:"Earn to Die",genre:"Racing",emoji:"🧟",path:"gfiles/games/earntodie/index.html"},
  {name:"Eggy Car",genre:"Arcade",emoji:"🥚",path:"gfiles/games/eggycar/index.html"},
  {name:"Flappy Bird",genre:"Arcade",emoji:"🐦",path:"gfiles/games/flappybird/index.html"},
  {name:"Flappy 2048",genre:"Arcade",emoji:"🐦",path:"gfiles/games/flappy2048/index.html"},
  {name:"Flight Simulator",genre:"Sim",emoji:"✈️",path:"gfiles/games/flightsimulator/index.html"},
  {name:"Friday Night Funkin",genre:"Rhythm",emoji:"🎵",path:"gfiles/games/fridaynightfunkin/index.html"},
  {name:"Fruit Ninja",genre:"Arcade",emoji:"🍉",path:"gfiles/games/fruitninja/index.html"},
  {name:"Geometry Dash",genre:"Rhythm",emoji:"🔷",path:"gfiles/games/geometrydash/index.html"},
  {name:"Getaway Shootout",genre:"Action",emoji:"🔫",path:"gfiles/games/getawayshootoutnew/index.html"},
  {name:"Gladihoppers",genre:"Fighting",emoji:"🗡️",path:"gfiles/games/gladihoppers/index.html"},
  {name:"Google Snake",genre:"Arcade",emoji:"🐍",path:"gfiles/games/googlesnake/index.html"},
  {name:"Grindcraft",genre:"Idle",emoji:"⛏️",path:"gfiles/games/grindcraft/index.html"},
  {name:"HexGL",genre:"Racing",emoji:"🔺",path:"gfiles/games/hexgl/index.html"},
  {name:"Hextris",genre:"Puzzle",emoji:"⬡",path:"gfiles/games/hextris/index.html"},
  {name:"Highway Traffic",genre:"Racing",emoji:"🛣️",path:"gfiles/games/highwaytraffic/index.html"},
  {name:"Learn to Fly",genre:"Arcade",emoji:"🐧",path:"gfiles/games/learntofly/index.html"},
  {name:"Little Alchemy",genre:"Puzzle",emoji:"⚗️",path:"gfiles/games/littlealchemy/index.html"},
  {name:"Monkey Mart",genre:"Sim",emoji:"🐒",path:"gfiles/games/monkeymart/index.html"},
  {name:"Moto X3M",genre:"Racing",emoji:"🏍️",path:"gfiles/games/motox3m/index.html"},
  {name:"OvO",genre:"Platformer",emoji:"🏃",path:"gfiles/games/ovo/index.html"},
  {name:"OvO 2",genre:"Platformer",emoji:"🏃",path:"gfiles/games/ovo2/index.html"},
  {name:"Pac-Man",genre:"Arcade",emoji:"👻",path:"gfiles/games/pacman/index.html"},
  {name:"Paper IO",genre:"Arcade",emoji:"📄",path:"gfiles/games/paperio/index.html"},
  {name:"Retro Bowl",genre:"Sports",emoji:"🏈",path:"gfiles/games/retrobowl/index.html"},
  {name:"Riddle School 2",genre:"Adventure",emoji:"🏫",path:"gfiles/games/riddleschool2/index.html"},
  {name:"Rooftop Snipers",genre:"Shooter",emoji:"🔭",path:"gfiles/games/rooftopsnipers/index.html"},
  {name:"Run 3",genre:"Runner",emoji:"🏃",path:"gfiles/games/run3/index.html"},
  {name:"Slope",genre:"Runner",emoji:"🔺",path:"gfiles/games/slope/index.html"},
  {name:"Slope 2",genre:"Runner",emoji:"🔻",path:"gfiles/games/slope2/index.html"},
  {name:"Snake",genre:"Arcade",emoji:"🐍",path:"gfiles/games/snake/index.html"},
  {name:"Solitaire",genre:"Card",emoji:"🃏",path:"gfiles/games/solitaire/index.html"},
  {name:"Space Invaders",genre:"Arcade",emoji:"👾",path:"gfiles/games/spaceinvaders/index.html"},
  {name:"Stack Ball",genre:"Arcade",emoji:"🔮",path:"gfiles/games/stackball/index.html"},
  {name:"Stickman Hook",genre:"Arcade",emoji:"🕷️",path:"gfiles/games/stickmanhook/index.html"},
  {name:"Subway Surfers",genre:"Runner",emoji:"🛹",path:"gfiles/games/subwaysurfers/index.html"},
  {name:"Tetris",genre:"Puzzle",emoji:"🟥",path:"gfiles/games/tetris/index.html"},
  {name:"Time Shooter",genre:"Shooter",emoji:"⏱️",path:"gfiles/games/timeshooter/index.html"},
  {name:"Time Shooter 2",genre:"Shooter",emoji:"⏱️",path:"gfiles/games/timeshooter2/index.html"},
  {name:"Time Shooter 3",genre:"Shooter",emoji:"⏱️",path:"gfiles/games/timeshooter3/index.html"},
  {name:"Tiny Fishing",genre:"Casual",emoji:"🎣",path:"gfiles/games/tinyfishing/index.html"},
  {name:"Tomb of the Mask",genre:"Arcade",emoji:"💀",path:"gfiles/games/tombofthemask/index.html"},
  {name:"Tunnel Rush",genre:"Runner",emoji:"🌀",path:"gfiles/games/tunnelrush/index.html"},
  {name:"Vex 3",genre:"Platformer",emoji:"🏅",path:"gfiles/games/vex3/index.html"},
  {name:"Vex 4",genre:"Platformer",emoji:"🏅",path:"gfiles/games/vex4/index.html"},
  {name:"Vex 5",genre:"Platformer",emoji:"🏅",path:"gfiles/games/vex5/index.html"},
  {name:"Vex 6",genre:"Platformer",emoji:"🏅",path:"gfiles/games/vex6/index.html"},
  {name:"World's Hardest Game 2",genre:"Puzzle",emoji:"🔴",path:"gfiles/games/worldshardestgame2/index.html"},
  {name:"Zombs Royale",genre:"Battle Royale",emoji:"🧟",path:"gfiles/games/zombsroyale/index.html"},
];

// ── SETTINGS & STATE ──
let settings = JSON.parse(localStorage.getItem('wg-settings')||'{}');
let favorites = JSON.parse(localStorage.getItem('wg-favs')||'[]');
let recentPlayed = JSON.parse(localStorage.getItem('wg-recent')||'[]');
let bookmarks = JSON.parse(localStorage.getItem('wg-bookmarks')||'[]');

// ── LOCK ──
function initLock(){
  const pwd = localStorage.getItem('wg-pwd');
  const lockEnabled = settings.lockEnabled;
  if(lockEnabled && pwd){
    document.getElementById('lock-screen').style.display='flex';
    document.getElementById('lock-setup').style.display='none';
    document.getElementById('lock-input').addEventListener('keydown',e=>{if(e.key==='Enter')tryUnlock();});
  } else if(!pwd){
    document.getElementById('lock-screen').style.display='flex';
    document.getElementById('lock-setup').style.display='block';
    document.querySelector('#lock-screen p').textContent='WELCOME — SET A PASSWORD OR SKIP';
    document.getElementById('lock-btn').textContent='Skip';
    document.getElementById('lock-btn').onclick=()=>{document.getElementById('lock-screen').style.display='none';};
  }
}
function tryUnlock(){
  const pwd = localStorage.getItem('wg-pwd');
  const val = document.getElementById('lock-input').value;
  if(val===pwd){
    document.getElementById('lock-screen').style.display='none';
  } else {
    document.getElementById('lock-error').textContent='Wrong password';
    document.getElementById('lock-input').value='';
  }
}
function setupPassword(){
  const val = prompt('Enter a new password:');
  if(val && val.trim()){
    localStorage.setItem('wg-pwd',val.trim());
    settings.lockEnabled=true;
    saveSettings();
    document.getElementById('lock-screen').style.display='none';
  }
}
function toggleLock(el){
  settings.lockEnabled=el.checked;
  saveSettings();
}

// ── CARD BUILDER ──
function thumbSrc(g){
  // Try loading thumbnail from gfiles repo
  const folder = g.path.replace('/index.html','');
  return `${folder}/thumbnail.png`;
}
function makeCard(g){
  const isFav = favorites.includes(g.name);
  const href = settings.newTab ? g.path : `game.html?src=${encodeURIComponent(g.path)}&name=${encodeURIComponent(g.name)}`;
  const target = settings.newTab ? 'target="_blank"' : '';
  const showThumb = settings.showThumbs !== false;
  const thumbHtml = showThumb
    ? `<img src="${thumbSrc(g)}" alt="" onerror="this.style.display='none'" loading="lazy"/>${g.emoji}`
    : g.emoji;
  return `<a class="game-card" href="${href}" ${target} onclick="trackPlay('${g.name.replace(/'/g,"\\'")}')">
    <div class="game-thumb">${thumbHtml}</div>
    <div class="game-info">
      <div class="game-name">${g.name}</div>
      <div class="game-genre">${g.genre}</div>
    </div>
    <span class="fav-btn ${isFav?'active':''}" onclick="toggleFav(event,'${g.name.replace(/'/g,"\\'")}')">★</span>
  </a>`;
}

// ── RENDER ──
function renderAll(list=games){
  document.getElementById('all-games-grid').innerHTML=list.map(makeCard).join('');
  document.getElementById('featured-grid').innerHTML=games.slice(0,8).map(makeCard).join('');
  renderFavs();
  renderRecent();
  updateCounts();
}
function renderFavs(){
  const favGames = games.filter(g=>favorites.includes(g.name));
  document.getElementById('fav-grid').innerHTML = favGames.length
    ? favGames.map(makeCard).join('')
    : '<div style="color:var(--text-dim);font-size:13px;grid-column:1/-1">No favorites yet — click ★ on a game card!</div>';
}
function renderRecent(){
  const recentGames = recentPlayed.map(n=>games.find(g=>g.name===n)).filter(Boolean);
  const html = recentGames.length ? recentGames.map(makeCard).join('') : '<div style="color:var(--text-dim);font-size:13px;grid-column:1/-1">No games played yet.</div>';
  document.getElementById('recent-grid').innerHTML=html;
  document.getElementById('recent-grid2').innerHTML=html;
}
function updateCounts(){
  document.getElementById('game-count').textContent=games.length;
  document.getElementById('fav-count').textContent=favorites.length;
  document.getElementById('stat-total').textContent=games.length;
  document.getElementById('stat-favs').textContent=favorites.length;
  document.getElementById('stat-played').textContent=recentPlayed.length;
}

// ── FAVORITES ──
function toggleFav(e, name){
  e.preventDefault(); e.stopPropagation();
  if(favorites.includes(name)){
    favorites=favorites.filter(f=>f!==name);
  } else {
    favorites.unshift(name);
  }
  localStorage.setItem('wg-favs',JSON.stringify(favorites));
  renderAll();
}

// ── RECENT PLAYED ──
function trackPlay(name){
  recentPlayed=recentPlayed.filter(n=>n!==name);
  recentPlayed.unshift(name);
  if(recentPlayed.length>12) recentPlayed=recentPlayed.slice(0,12);
  localStorage.setItem('wg-recent',JSON.stringify(recentPlayed));
}

// ── SEARCH ──
function filterGames(q){
  const f=games.filter(g=>g.name.toLowerCase().includes(q.toLowerCase())||g.genre.toLowerCase().includes(q.toLowerCase()));
  document.getElementById('all-games-grid').innerHTML=f.map(makeCard).join('');
  if(q) showView('games');
}

// ── VIEWS ──
function showView(id, el){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.getElementById('view-'+id).classList.add('active');
  const titles={home:'Home',games:'Games',favorites:'Favorites',recent:'Recently Played',proxy:'Proxy'};
  document.getElementById('page-title').textContent=titles[id]||id;
  if(el) el.classList.add('active');
  else {
    document.querySelectorAll('.nav-item').forEach(n=>{
      if(n.getAttribute('onclick')&&n.getAttribute('onclick').includes(`'${id}'`)) n.classList.add('active');
    });
  }
}

// ── PROXY ──
function loadProxy(){
  let url=document.getElementById('proxy-url').value.trim();
  if(!url) return;
  if(!url.startsWith('http')) url='https://'+url;
  document.getElementById('proxy-iframe').src=url;
  document.getElementById('proxy-url').value=url;
}
function proxyBack(){try{document.getElementById('proxy-iframe').contentWindow.history.back();}catch(e){}}
function proxyForward(){try{document.getElementById('proxy-iframe').contentWindow.history.forward();}catch(e){}}
function proxyRefresh(){const f=document.getElementById('proxy-iframe');f.src=f.src;}
document.getElementById('proxy-url').addEventListener('keydown',e=>{if(e.key==='Enter')loadProxy();});

// ── BOOKMARKS ──
function renderBookmarks(){
  const bar=document.getElementById('bookmark-bar');
  bar.innerHTML='';
  bookmarks.forEach((bm,i)=>{
    const chip=document.createElement('div');
    chip.className='bookmark-chip';
    chip.innerHTML=`${bm.name} <span class="del-bm" onclick="removeBookmark(${i})">✕</span>`;
    chip.querySelector('.del-bm').addEventListener('click',e=>e.stopPropagation());
    chip.addEventListener('click',()=>{
      document.getElementById('proxy-url').value=bm.url;
      loadProxy();
    });
    bar.appendChild(chip);
  });
  const addBtn=document.createElement('button');
  addBtn.className='add-bm-btn';
  addBtn.textContent='+ Bookmark';
  addBtn.onclick=addBookmark;
  bar.appendChild(addBtn);
}
function addBookmark(){
  const url=document.getElementById('proxy-url').value.trim()||document.getElementById('proxy-iframe').src;
  if(!url||url==='about:blank') return alert('Navigate to a page first, then bookmark it!');
  const name=prompt('Bookmark name:',url.replace(/https?:\/\//,'').split('/')[0]);
  if(name){
    bookmarks.push({name,url});
    localStorage.setItem('wg-bookmarks',JSON.stringify(bookmarks));
    renderBookmarks();
  }
}
function removeBookmark(i){
  bookmarks.splice(i,1);
  localStorage.setItem('wg-bookmarks',JSON.stringify(bookmarks));
  renderBookmarks();
}

// ── SETTINGS PANEL ──
function openSettings(){document.getElementById('settings-overlay').classList.add('open');}
function closeSettings(){document.getElementById('settings-overlay').classList.remove('open');}
function closeSettingsOutside(e){if(e.target===document.getElementById('settings-overlay'))closeSettings();}
function saveSettings(){
  settings.newTab=document.getElementById('newtab-toggle').checked;
  settings.panic=document.getElementById('panic-toggle').checked;
  settings.showThumbs=document.getElementById('thumb-toggle').checked;
  localStorage.setItem('wg-settings',JSON.stringify(settings));
}

// ── THEME ──
const themes={
  silver:{'--silver':'#b0bec5','--silver-bright':'#e0e8ef','--silver-dim':'#607d8b'},
  blue:{'--silver':'#64b5f6','--silver-bright':'#90caf9','--silver-dim':'#42a5f5'},
  green:{'--silver':'#69f0ae','--silver-bright':'#b9f6ca','--silver-dim':'#00e676'},
  purple:{'--silver':'#ce93d8','--silver-bright':'#e1bee7','--silver-dim':'#ab47bc'},
  orange:{'--silver':'#ff8a65','--silver-bright':'#ffccbc','--silver-dim':'#ff7043'},
  pink:{'--silver':'#f48fb1','--silver-bright':'#fce4ec','--silver-dim':'#e91e63'},
  yellow:{'--silver':'#fff176','--silver-bright':'#fffde7','--silver-dim':'#f9a825'},
  teal:{'--silver':'#80cbc4','--silver-bright':'#e0f2f1','--silver-dim':'#26a69a'},
};
function setTheme(name, el){
  const t=themes[name]||themes.silver;
  Object.entries(t).forEach(([k,v])=>document.documentElement.style.setProperty(k,v));
  document.querySelectorAll('.color-swatch').forEach(s=>s.classList.remove('active'));
  if(el) el.classList.add('active');
  settings.theme=name; saveSettings();
}

// ── BACKGROUND ──
const bgs={
  none:'none',
  ocean:'linear-gradient(135deg,#0d1b2a,#1b263b)',
  galaxy:'linear-gradient(135deg,#1a0a2e,#2d1b69)',
  forest:'linear-gradient(135deg,#0a1a0a,#1a3a1a)',
  crimson:'linear-gradient(135deg,#1a0a0a,#3a1010)',
  midnight:'linear-gradient(135deg,#0a0a1a,#10102a,#1a0a2e)',
};
function setBg(name, el){
  document.documentElement.style.setProperty('--custom-bg', bgs[name]||'none');
  document.querySelectorAll('.bg-option').forEach(b=>b.classList.remove('active'));
  if(el) el.classList.add('active');
  settings.bg=name; saveSettings();
}

// ── COMPACT ──
function toggleCompact(el){
  document.querySelectorAll('.games-grid').forEach(g=>{
    g.style.gridTemplateColumns=el.checked?'repeat(auto-fill,minmax(120px,1fr))':'repeat(auto-fill,minmax(160px,1fr))';
  });
  settings.compact=el.checked; saveSettings();
}

// ── TAB CLOAK ──
function cloakTab(val){
  const c={none:{title:'Willie Games',icon:''},google:{title:'Google',icon:'https://www.google.com/favicon.ico'},classroom:{title:'Google Classroom',icon:'https://ssl.gstatic.com/classroom/favicon.png'},docs:{title:'Google Docs',icon:'https://ssl.gstatic.com/docs/documents/images/kix-favicon7.ico'}};
  document.title=c[val].title;
  if(c[val].icon){let l=document.querySelector("link[rel~='icon']");if(!l){l=document.createElement('link');l.rel='icon';document.head.appendChild(l);}l.href=c[val].icon;}
  settings.cloak=val; saveSettings();
}

// ── PASSWORD ──
function savePassword(){
  const p1=document.getElementById('pwd-new').value;
  const p2=document.getElementById('pwd-confirm').value;
  const msg=document.getElementById('pwd-msg');
  if(!p1){msg.textContent='Enter a password.';return;}
  if(p1!==p2){msg.textContent='Passwords do not match.';return;}
  localStorage.setItem('wg-pwd',p1);
  settings.lockEnabled=document.getElementById('lock-toggle').checked;
  saveSettings();
  msg.textContent='Password saved!';
  document.getElementById('pwd-new').value='';
  document.getElementById('pwd-confirm').value='';
}

// ── PANIC KEY ──
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'&&settings.panic!==false){
    document.body.innerHTML='';
    document.title='New Tab';
  }
});

// ── RESTORE SETTINGS ──
function restoreSettings(){
  if(settings.theme) setTheme(settings.theme);
  if(settings.bg) setBg(settings.bg);
  if(settings.cloak) cloakTab(settings.cloak);
  document.getElementById('newtab-toggle').checked=!!settings.newTab;
  document.getElementById('panic-toggle').checked=settings.panic!==false;
  document.getElementById('thumb-toggle').checked=settings.showThumbs!==false;
  document.getElementById('lock-toggle').checked=!!settings.lockEnabled;
  if(settings.compact){document.getElementById('compact-toggle').checked=true;toggleCompact({checked:true});}
}

// ── INIT ──
restoreSettings();
renderAll();
renderBookmarks();
initLock();
</script>
</body>
</html>
